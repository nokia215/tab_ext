{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "allowJs": false,
    "types": ["chrome", "svelte"]
  },
  "include": ["src", "vite.config.ts", "scripts", "src/**/*.svelte"]
}
