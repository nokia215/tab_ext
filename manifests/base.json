{
  "manifest_version": 3,
  "name": "Tab Saver",
  "version": "0.2.0",
  "description": "Save current window tabs to Supabase and restore them later.",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://*.supabase.co/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
